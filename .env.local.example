# Copy this file to .env.local and provide local-only values.
# Never commit .env.local.
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/pathome_db
SPRING_DATASOURCE_USERNAME=pathome
SPRING_DATASOURCE_PASSWORD=
JWT_SECRET=
CLOUDINARY_CLOUD_NAME=hbgzetjy
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Google login remains disabled until its dedicated profile is configured.
VITE_GOOGLE_LOGIN_ENABLED=false

# Enable only for the first migration of an existing pre-Flyway database.
PATHOME_DATABASE_ALLOW_FLYWAY_BASELINE=false
# Optional frontend endpoint overrides. Leave blank for same-origin development
# through the Vite proxy, including access from phones on the same network.
VITE_API_BASE_URL=
VITE_OAUTH_BASE_URL=
