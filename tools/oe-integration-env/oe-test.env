# Pathome OE integration environment - explicit target designation.
#
# This file is the opt-in. Sourcing it designates exactly one disposable PostgreSQL
# database and nothing else; the guard in lib/db-guard.sh still refuses every other
# target, every remote host, and every destructive operation on an unmarked database.
#
# It contains no secrets. Disposable credentials are generated at run time into the run
# directory (default /private/tmp/pathome-oe-test/secrets.env) and never live in the repo.

PATHOME_OE_TEST_ALLOW_DISPOSABLE=true

# The single disposable integration database. Only names matching
# ^pathome_oe_test_[a-z0-9_]{1,40}$ can be used, so this can never be confused with
# pathome_db, pathome_autonomous_v2_test, or any production/staging database.
PATHOME_OE_TEST_DB=pathome_oe_test_integration

PATHOME_OE_TEST_DB_HOST=localhost
PATHOME_OE_TEST_DB_PORT=5432
PATHOME_OE_TEST_DB_ADMIN_USER=postgres
PATHOME_OE_TEST_DB_APP_USER=pathome

# Ephemeral run directory for logs, evidence and disposable credentials.
PATHOME_OE_TEST_RUN_DIR=/private/tmp/pathome-oe-test
